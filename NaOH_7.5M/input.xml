<simulation verbosity='high'> #整个 i-pi 模拟的根节点
  <output prefix='simulation'> #所有输出文件名前缀
    <properties stride='4' filename='out'>  [ step, time{picosecond}, conserved{electronvolt}, temperature{kelvin}, potential{electronvolt} ] </properties> #每 4 步输出一次系统性质到 simulation.out
    <trajectory filename='pos' stride='4'> positions{angstrom} </trajectory> #每 4 步输出一次原子坐标
    <trajectory filename='committee_pot' stride='4' extra_type='committee_pot'> extras </trajectory> #每 4 步输出 committee 返回的额外信息里的 committee_pot
    <trajectory filename='committee_sigma' stride='4' extra_type='committee_uncertainty'> extras </trajectory> #每 4 步输出 committee 的不确定性指标
    <checkpoint stride='300'/> #每 300 步写一次 checkpoint
  </output>
  <total_steps>400000</total_steps> #总 MD 步数
  <total_time>172800</total_time> #最大墙钟时间
  <prng>
    <seed>31415</seed> #随机数种子
  </prng>
  <ffcommittee name="committee"> #committee 的组合力场
    <alpha> 1.0 </alpha> 
    <active_output> active </active_output>
    <active_thresh units="electronvolt"> 1.0 </active_thresh>
    <ffsocket name='nnpNa041' mode='unix' matching="any">
        <address>nnpNa121A1</address> <latency> 2e-4 </latency>
    </ffsocket>
    <ffsocket name='nnpNa042' mode='unix' matching="any">
        <address>nnpNa122A1</address> <latency> 2e-4 </latency>
    </ffsocket>
    <ffsocket name='nnpNa043' mode='unix' matching="any">
        <address>nnpNa123A1</address> <latency> 2e-4 </latency>
    </ffsocket>
    <ffsocket name='nnpNa044' mode='unix' matching="any">
        <address>nnpNa124A1</address> <latency> 2e-4 </latency>
    </ffsocket>
    <ffsocket mode='unix' matching='any' name='nnpNa045'>
        <address>nnpNa125A1</address>
         <latency>  2.00000000e-04</latency>
      </ffsocket>
    <ffsocket name='nnpNa046' mode='unix' matching="any">
        <address>nnpNa126A1</address> <latency> 2e-4 </latency>
    </ffsocket>
  </ffcommittee>
  <system>
    <initialize nbeads='1'>
      <file mode='xyz'> init.xyz </file>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
<cell mode='abc' units='angstrom'> [16.63,16.63,44.10] </cell>
    </initialize>
    <forces>
      <force forcefield='committee'> </force>
    </forces>
    <motion mode='dynamics'> #分子动力学
      <dynamics mode='nvt'> #NVT系综
        <timestep units='femtosecond'> 0.50 </timestep>  #时间步长0.5fs
        <thermostat mode='pile_g'> #使用 PILE-G 恒温器
          <tau units='femtosecond'> 2000 </tau> #恒温器时间尺度
        </thermostat>
      </dynamics>
    </motion>
    <ensemble>
      <temperature units='kelvin'> 300 </temperature> #目标温度 300 K
    </ensemble>
  </system>
</simulation>
