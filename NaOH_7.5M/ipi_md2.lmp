###############################################################################
# MD simulation for NN water
###############################################################################

###############################################################################
# VARIABLES
###############################################################################
clear
# Configuration files
variable cfgFile         string "nnp-data/init.data"
# Timesteps
variable numSteps        equal  5
variable dt              equal  0.0005
# NN
variable nnpCutoff       equal  6.50
variable nnpDir          string "nnp-data2"
# Masses
variable mass_H          equal  1.00794
variable mass_O          equal  15.9994
variable mass_Na         equal  23.98977

###############################################################################
# GENERAL SETUP
###############################################################################
units metal
boundary p p p
atom_style atomic
read_data ${cfgFile}
mass 1 ${mass_H}
mass 2 ${mass_O}
mass 3 ${mass_Na}
timestep ${dt}
thermo 1

###############################################################################
# NN
###############################################################################
pair_style nnp dir ${nnpDir} showew yes resetew yes maxew 100 cflength 1.8897261328 cfenergy 0.0367493254 emap "1:H,2:O,3:Na"

pair_coeff * * ${nnpCutoff}

fix 1 all ipi nnpNa122A1 32344 unix
run 100000000
